# Visual Studio build output.
# These names match at any depth, so they cover both the solution-level
# Debug/ and Release/ and the intermediate source/Debug/ and source/Release/.
# Release/ot4xb_log.exe ships as a GitHub release asset, never as a commit.
Debug/
Release/
x64/
Win32/
ipch/
*.obj
*.res
*.tlog
*.ilk
*.idb
*.iobj
*.ipdb
*.pdb
*.exp
*.lib
*.exe
*.recipe
*.FileListAbsolute.txt
*.Build.CppClean.log

# Per-user and IDE state
.vs/
*.user
*.suo
*.aps
*.opendb
*.VC.db
*.sdf
*.opensdf

# Runtime output of the tool itself
*.log

# Generated by mkskill from _mkskill/mkskill.config.xml
__publish.bat

# NOT ignored, and meant to be committed: source/ot4xb_log_version.h and
# source/ot4xb_log_version.props are generated too, but the project needs
# them to build without mkskill installed.
